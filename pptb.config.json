{
    "invocation": {
        "version": "1.0.0",
        "capabilities": ["dataverse-search"],
        "prefill": {
            "properties": {
                "query": {
                    "type": "string",
                    "description": "Natural-language agent request for Dataverse search"
                },
                "searchTerm": {
                    "type": "string"
                },
                "scope": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": ["records", "metadata", "solutionComponents"]
                    },
                    "default": ["records"]
                },
                "entities": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Optional logical entity names to limit the search scope"
                },
                "lookupField": {
                    "type": "string",
                    "description": "Optional lookup field to search by related record primary name"
                },
                "lookupTargetEntity": {
                    "type": "string",
                    "description": "Optional target entity for lookup-field searches"
                },
                "lookupTargetPrimaryNameField": {
                    "type": "string",
                    "description": "Optional target primary-name field for lookup-field searches"
                },
                "maxResults": {
                    "type": "number",
                    "default": 50
                },
                "matchCase": {
                    "type": "boolean",
                    "default": false
                }
            }
        },
        "returnTopic": {
            "properties": {
                "totalMatches": {
                    "type": "number"
                },
                "matches": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "type": { "type": "string" },
                            "entityName": { "type": "string" },
                            "recordId": { "type": "string" },
                            "displayName": { "type": "string" },
                            "matchedField": { "type": "string" },
                            "context": { "type": "string" }
                        }
                    }
                }
            }
        }
    },
    "agents": {
        "version": "1.0.0",
        "invokable": true,
        "modes": ["one-way", "two-way"],
        "defaultMode": "two-way",
        "timeoutMS": 15000,
        "headless": true,
        "executionModes": ["windowed", "headless"],
        "defaultExecutionMode": "headless",
        "headlessEntry": "dist/headless.js"
    }
}
